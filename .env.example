# ── Whetstone configuration ──────────────────────────────────────────────
# The advisor, the scoring engine, and the closing lesson all run on Claude.
# With NO key set, Whetstone runs in DEMO mode (deterministic stand-ins) so the
# full experience — pushback, a climbing scoreboard, auto-export, and a lesson —
# still works end to end.
ANTHROPIC_API_KEY=

# Force demo mode even when a key is present (handy for offline UI work).
# WHETSTONE_DEMO=1

# Models — split by job on purpose: a fast, responsive model drives the live
# conversation, while a more deliberate model does the judgment work (scoring +
# lesson). Adaptive thinking / effort are applied automatically only on models
# that support them, so any swap below stays valid (incl. Haiku).
# WHETSTONE_ADVISOR_MODEL=claude-sonnet-4-6   # fast + sharp; use claude-haiku-4-5 for even snappier
# WHETSTONE_SCORING_MODEL=claude-opus-4-8     # deliberate grader + prompt synthesis
# WHETSTONE_LESSON_MODEL=claude-opus-4-8      # one-shot at the end; quality over speed
# WHETSTONE_BUILDER_MODEL=claude-sonnet-4-6   # generates the app (streamed); fast, strong coder
# WHETSTONE_COACH_MODEL=claude-opus-4-8       # teaches a concept after each build step

# Overall score (1–100) the idea must clear to auto-export. Default 80.
# WHETSTONE_THRESHOLD=80

# The connected AI builder the refined prompt exports to.
# One of: bolt | v0 | lovable | claude   (default: bolt)
# WHETSTONE_BUILDER=bolt

# Optional: a server-to-server webhook that automatically receives the refined
# prompt on export — a true hands-free hand-off into your own pipeline.
# BUILDER_WEBHOOK_URL=
